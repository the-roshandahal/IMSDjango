DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3

# --- Production (cPanel) reference -- do not uncomment here, this file is
# for local dev. Put real values in the .env you create by hand on the
# server; it is gitignored and a `git pull` will never touch it.
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_SECRET_KEY=<generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())">
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=cleantech1.com.au,www.cleantech1.com.au
# DATABASE_URL=mysql://cpanelusername_dbuser:dbpassword@localhost:3306/cpanelusername_ims
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.yourdomain.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@yourdomain.com
# EMAIL_HOST_PASSWORD=<the mailbox password from cPanel Email Accounts>
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# Read once by `manage.py ensure_superuser` (see deploy.sh / .cpanel.yml) to
# create your first admin login on hosts with no Terminal/SSH access. Safe
# to leave set permanently -- it no-ops once that username already exists.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=noreply@yourdomain.com
# DJANGO_SUPERUSER_PASSWORD=<pick a strong password>
SESSION_INACTIVITY_TIMEOUT_SECONDS=1800
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_COOLDOWN_MINUTES=15
PASSWORD_MAX_AGE_DAYS=90
